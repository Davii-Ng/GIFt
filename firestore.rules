rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/contributions/{gifId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['gifId', 'title', 'description', 'visibility', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['gifId', 'title', 'description', 'visibility', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.gifId == gifId
        && gifId.matches('contrib_[a-f0-9]{32}')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 1000
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1000
        && request.resource.data.visibility in ['private', 'public']
        && request.resource.data.status in ['queued', 'rendering', 'indexing', 'ready', 'failed', 'cancelled']
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
    }
    match /users/{uid}/favorites/{gifId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['gifId'])
        && request.resource.data.keys().hasOnly(['gifId'])
        && request.resource.data.gifId is string
        && request.resource.data.gifId == gifId
        && gifId.size() > 0 && gifId.size() <= 100;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
